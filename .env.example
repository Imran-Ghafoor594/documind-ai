# Backend environment. Set these in Render, not in the React build.
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/documind
UPLOAD_DIR=/var/data/uploads
CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com
GROQ_API_KEY=
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_JSON_MODE=true
AI_MAX_COMPLETION_TOKENS=4096
AI_MAX_TEXT_CHARS=12000
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
OCR_LANGUAGES=eng
OCR_DPI=150
OCR_TIMEOUT_SECONDS=20
# Tesseract is installed in backend/Dockerfile. Nothing to install on your laptop.
# Local development only: APP_ENV=development, DATABASE_URL=sqlite:///data/documind.db,
# UPLOAD_DIR=data/uploads, CORS_ORIGINS=http://localhost:5173

# Free temporary demo (APP_ENV=demo): never use with customer data.
# APP_ENV=demo
# DEMO_ACCESS_CODE=use-a-random-code-of-at-least-16-characters
# DEMO_SIGNING_SECRET=use-a-different-random-secret-of-at-least-32-characters
# CORS_ORIGINS=https://your-static-site.onrender.com
